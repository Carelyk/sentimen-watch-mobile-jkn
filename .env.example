# Salin file ini menjadi .env lalu isi nilainya.
# Tanpa kunci LLM, pipeline tetap jalan (hanya bagian narasi AI yang dilewati).

# --- Aplikasi target ---
APP_ID=app.bpjs.mobile
APP_NAME=Mobile JKN
REVIEW_COUNT=200

# --- Ambang deteksi anomali ---
BASELINE_DAYS=7
MIN_REVIEWS=20
NEG_RATIO_ALERT=0.35
NEG_RATIO_INCREASE=0.5

# --- LLM narasi (isi salah satu atau dua-duanya; Gemini dipakai lebih dulu) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Notifikasi ---
# GitHub Issue: kanal utama (tanpa akun tambahan, jadi rekam jejak di repo).
# Di GitHub Actions nilainya terisi otomatis; untuk jalan lokal, isi PAT sendiri.
GITHUB_TOKEN=
GITHUB_REPOSITORY=Carelyk/sentimen-watch

# Discord webhook: opsional, kalau mau notifikasi instan.
DISCORD_WEBHOOK_URL=

# --- Google Sheets untuk Looker Studio (opsional) ---
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
